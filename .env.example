# =============================================================================
# KAVITHA & ASSOCIATES — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and fill in your Supabase project credentials.
#
# IMPORTANT SECURITY RULE:
# ONLY use the public 'anon' key here.
# NEVER include the privileged 'service_role' secret key in frontend environment variables.
# All data access is protected by Supabase Row Level Security (RLS) policies.
# =============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (safe for browser client with RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Practice Environment Flag
VITE_APP_ENV=production

# =============================================================================
# PRACTICE MANAGEMENT PORTAL SECRET ENTRY ROUTE
# =============================================================================
# Replaces publicly obvious '/admin' with an explicitly configured, non-discoverable route.
# Security Requirements:
# 1. Must start with '/' and contain at least 12 random characters.
# 2. BANNED: Predictable words ('admin', 'login', 'portal', 'cpanel') and retired dev defaults.
# 3. Configure VITE_ADMIN_SECRET_PATH in Cloudflare Pages Dashboard (Environment Variables).
# 4. NEVER include this secret route in sitemaps, robots.txt, navigation, or public links.
# Example: VITE_ADMIN_SECRET_PATH=/sec-ca-8f2a9c1e7d4b6
VITE_ADMIN_SECRET_PATH=/sec-ca-8f2a9c1e7d4b6
