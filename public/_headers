# ==============================================================================
# Cloudflare Pages Security & Cache Configuration
# ==============================================================================

# Global Security Baseline for all routes
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://raw.githubusercontent.com https://avatars.githubusercontent.com https://*.google.com https://*.googleapis.com https://*.gstatic.com; connect-src 'self' https://api.github.com https://github.com https://*.supabase.co wss://*.supabase.co; frame-src 'self'; frame-ancestors 'self'; worker-src 'self' blob:; child-src 'self' blob:;

# Immutable Caching for Vite Hashed Production Assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Freshness Control for CMS Admin Console and Configuration
/admin/*
  Cache-Control: public, max-age=0, must-revalidate

# Freshness Control for Public SPA HTML Entrypoint
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Cache Policy for CMS Uploaded Media
/uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Cache Policy for SEO Metadata Files
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
